# Purpose: template for the local .env file — lists every environment
# variable the app (app/config.py) and docker-compose.yml read, with safe
# defaults/blanks. .env itself is gitignored (it can hold a real API key),
# so this checked-in template is how anyone sets up their own local copy.
#
# Copy to .env before running docker compose: cp .env.example .env

# "dev" or "prod" — selects Dockerfile.<APP_ENV> in docker-compose.yml.
APP_ENV=dev
APP_PORT=8000

# Individual pieces, not a raw connection string — app/config.py's Settings
# assembles DATABASE_URL from these at runtime, and docker-compose.yml's
# "db" service reads the same values, so there is exactly one place each
# credential is typed.
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=orchestra
POSTGRES_PASSWORD=orchestra
POSTGRES_DB=orchestra

# Only ever read by tests/settings.py — a separate database on the same
# Postgres instance so tests never touch dev data.
POSTGRES_TEST_DB=orchestra_test

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

MAX_CONCURRENT_LLM_CALLS=5
STEP_RETRY_ATTEMPTS=2
